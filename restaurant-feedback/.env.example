# Copy this file to .env and fill in your values.

# --- Restaurant ---
RESTAURANT_NAME=DADA
# Optional: dishes the AI may mention in suggestions (keeps reviews specific and real)
RESTAURANT_HIGHLIGHTS=misal pav, veg thali, filter coffee
# Optional: your Google review link. After submitting, EVERY customer (any rating) is offered
# a one-tap "also share on Google" button with their review pre-copied.
GOOGLE_REVIEW_URL=
# Public address of the site, used when printing QR codes (e.g. https://feedback.spicegarden.in)
PUBLIC_URL=

# --- Admin dashboard ---
ADMIN_PASSWORD=Kuldeep@1

# --- AI (OpenAI or any OpenAI-compatible API) ---
# Leave OPENAI_API_KEY empty to use the built-in suggestion templates (free, works offline).
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini
# Other providers: set the base URL to their OpenAI-compatible endpoint, e.g.
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_BASE_URL=https://api.openai.com/v1
# If the AI takes longer than this, customers get template suggestions instead
AI_TIMEOUT_MS=6000

# --- Server ---
PORT=3000
# India = 330 (UTC+5:30). Used to group the dashboard's daily chart by your local date.
TZ_OFFSET_MINUTES=330
# DB_PATH=./data/feedback.db
